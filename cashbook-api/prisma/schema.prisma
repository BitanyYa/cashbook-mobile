generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model activity_logs {
  id           BigInt     @id @default(autoincrement()) @db.UnsignedBigInt
  action       String
  user_id      BigInt     @db.UnsignedBigInt
  business_id  BigInt     @db.UnsignedBigInt
  subject_type String
  subject_id   BigInt     @db.UnsignedBigInt
  details      String?    @db.LongText
  created_at   DateTime?  @db.Timestamp(0)
  updated_at   DateTime?  @db.Timestamp(0)
  businesses   businesses @relation(fields: [business_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "activity_logs_business_id_foreign")
  users        users      @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "activity_logs_user_id_foreign")

  @@index([business_id], map: "activity_logs_business_id_foreign")
  @@index([subject_type, subject_id], map: "activity_logs_subject_type_subject_id_index")
  @@index([user_id], map: "activity_logs_user_id_foreign")
}

model book_user {
  id         BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  book_id    BigInt    @db.UnsignedBigInt
  user_id    BigInt    @db.UnsignedBigInt
  role       String    @default("employee") @db.VarChar(50)
  created_at DateTime? @db.Timestamp(0)
  updated_at DateTime? @db.Timestamp(0)
  books      books     @relation(fields: [book_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "book_user_book_id_foreign")
  users      users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "book_user_user_id_foreign")

  @@unique([book_id, user_id], map: "book_user_book_id_user_id_unique")
  @@index([user_id], map: "book_user_user_id_foreign")
}

model books {
  id                     BigInt                   @id @default(autoincrement()) @db.UnsignedBigInt
  business_id            BigInt                   @db.UnsignedBigInt
  name                   String
  description            String?                  @db.Text
  currency               String                   @default("BDT") @db.VarChar(3)
  created_at             DateTime?                @db.Timestamp(0)
  updated_at             DateTime?                @db.Timestamp(0)
  deleted_at             DateTime?                @db.Timestamp(0)
  book_user              book_user[]
  businesses             businesses               @relation(fields: [business_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "books_business_id_foreign")
  recurring_transactions recurring_transactions[]
  transactions           transactions[]

  @@index([business_id], map: "books_business_id_foreign")
}

model budgets {
  id          BigInt     @id @default(autoincrement()) @db.UnsignedBigInt
  business_id BigInt     @db.UnsignedBigInt
  category_id BigInt     @db.UnsignedBigInt
  month       DateTime   @db.Date
  amount      Decimal    @db.Decimal(15, 2)
  created_at  DateTime?  @db.Timestamp(0)
  updated_at  DateTime?  @db.Timestamp(0)
  businesses  businesses @relation(fields: [business_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "budgets_business_id_foreign")
  categories  categories @relation(fields: [category_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "budgets_category_id_foreign")

  @@unique([business_id, category_id, month], map: "budgets_business_id_category_id_month_unique")
  @@index([category_id], map: "budgets_category_id_foreign")
}

model business_user {
  id          BigInt     @id @default(autoincrement()) @db.UnsignedBigInt
  business_id BigInt     @db.UnsignedBigInt
  user_id     BigInt     @db.UnsignedBigInt
  role        String     @default("employee") @db.VarChar(50)
  created_at  DateTime?  @db.Timestamp(0)
  updated_at  DateTime?  @db.Timestamp(0)
  businesses  businesses @relation(fields: [business_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "business_user_business_id_foreign")
  users       users      @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "business_user_user_id_foreign")

  @@unique([business_id, user_id], map: "business_user_business_id_user_id_unique")
  @@index([user_id], map: "business_user_user_id_foreign")
}

model businesses {
  id                     BigInt                   @id @default(autoincrement()) @db.UnsignedBigInt
  name                   String
  currency               String                   @default("USD") @db.VarChar(3)
  created_at             DateTime?                @db.Timestamp(0)
  updated_at             DateTime?                @db.Timestamp(0)
  deleted_at             DateTime?                @db.Timestamp(0)
  activity_logs          activity_logs[]
  books                  books[]
  budgets                budgets[]
  business_user          business_user[]
  categories             categories[]
  recurring_transactions recurring_transactions[]
  transactions           transactions[]
}

model cache {
  key        String @id
  value      String @db.MediumText
  expiration Int
}

model cache_locks {
  key        String @id
  owner      String
  expiration Int
}

model categories {
  id                     BigInt                   @id @default(autoincrement()) @db.UnsignedBigInt
  business_id            BigInt                   @db.UnsignedBigInt
  name                   String
  type                   categories_type
  created_at             DateTime?                @db.Timestamp(0)
  updated_at             DateTime?                @db.Timestamp(0)
  budgets                budgets[]
  businesses             businesses               @relation(fields: [business_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "categories_business_id_foreign")
  recurring_transactions recurring_transactions[]
  transactions           transactions[]

  @@index([business_id], map: "categories_business_id_foreign")
}

model failed_jobs {
  id         BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  uuid       String   @unique(map: "failed_jobs_uuid_unique")
  connection String   @db.Text
  queue      String   @db.Text
  payload    String   @db.LongText
  exception  String   @db.LongText
  failed_at  DateTime @default(now()) @db.Timestamp(0)
}

model job_batches {
  id             String  @id
  name           String
  total_jobs     Int
  pending_jobs   Int
  failed_jobs    Int
  failed_job_ids String  @db.LongText
  options        String? @db.MediumText
  cancelled_at   Int?
  created_at     Int
  finished_at    Int?
}

model jobs {
  id           BigInt @id @default(autoincrement()) @db.UnsignedBigInt
  queue        String
  payload      String @db.LongText
  attempts     Int    @db.UnsignedTinyInt
  reserved_at  Int?   @db.UnsignedInt
  available_at Int    @db.UnsignedInt
  created_at   Int    @db.UnsignedInt

  @@index([queue], map: "jobs_queue_index")
}

model migrations {
  id        Int    @id @default(autoincrement()) @db.UnsignedInt
  migration String
  batch     Int
}

model notifications {
  id              String    @id @db.Char(36)
  type            String
  notifiable_type String
  notifiable_id   BigInt    @db.UnsignedBigInt
  data            String    @db.Text
  read_at         DateTime? @db.Timestamp(0)
  created_at      DateTime? @db.Timestamp(0)
  updated_at      DateTime? @db.Timestamp(0)

  @@index([notifiable_type, notifiable_id], map: "notifications_notifiable_type_notifiable_id_index")
}

model password_reset_tokens {
  email      String    @id
  token      String
  created_at DateTime? @db.Timestamp(0)
}

model recurring_transactions {
  id            BigInt                           @id @default(autoincrement()) @db.UnsignedBigInt
  business_id   BigInt                           @db.UnsignedBigInt
  book_id       BigInt                           @db.UnsignedBigInt
  category_id   BigInt?                          @db.UnsignedBigInt
  user_id       BigInt                           @db.UnsignedBigInt
  amount        Decimal                          @db.Decimal(15, 2)
  type          recurring_transactions_type
  frequency     recurring_transactions_frequency
  next_due_date DateTime                         @db.Date
  description   String?                          @db.Text
  created_at    DateTime?                        @db.Timestamp(0)
  updated_at    DateTime?                        @db.Timestamp(0)
  books         books                            @relation(fields: [book_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "recurring_transactions_book_id_foreign")
  businesses    businesses                       @relation(fields: [business_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "recurring_transactions_business_id_foreign")
  categories    categories?                      @relation(fields: [category_id], references: [id], onUpdate: NoAction, map: "recurring_transactions_category_id_foreign")
  users         users                            @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "recurring_transactions_user_id_foreign")

  @@index([book_id], map: "recurring_transactions_book_id_foreign")
  @@index([business_id], map: "recurring_transactions_business_id_foreign")
  @@index([category_id], map: "recurring_transactions_category_id_foreign")
  @@index([user_id], map: "recurring_transactions_user_id_foreign")
}

model sessions {
  id            String  @id
  user_id       BigInt? @db.UnsignedBigInt
  ip_address    String? @db.VarChar(45)
  user_agent    String? @db.Text
  payload       String  @db.LongText
  last_activity Int

  @@index([last_activity], map: "sessions_last_activity_index")
  @@index([user_id], map: "sessions_user_id_index")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model transactions {
  id                                    BigInt              @id @default(autoincrement()) @db.UnsignedBigInt
  business_id                           BigInt              @db.UnsignedBigInt
  book_id                               BigInt              @db.UnsignedBigInt
  category_id                           BigInt?             @db.UnsignedBigInt
  user_id                               BigInt              @db.UnsignedBigInt
  amount                                Decimal             @db.Decimal(15, 2)
  type                                  transactions_type
  mode                                  String?
  status                                transactions_status @default(pending)
  approved_by                           BigInt?             @db.UnsignedBigInt
  description                           String?             @db.Text
  contact_name                          String?
  transaction_date                      DateTime            @db.DateTime(0)
  image_path                            String?
  created_at                            DateTime?           @db.Timestamp(0)
  updated_at                            DateTime?           @db.Timestamp(0)
  deleted_at                            DateTime?           @db.Timestamp(0)
  users_transactions_approved_byTousers users?              @relation("transactions_approved_byTousers", fields: [approved_by], references: [id], onUpdate: NoAction, map: "transactions_approved_by_foreign")
  books                                 books               @relation(fields: [book_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "transactions_book_id_foreign")
  businesses                            businesses          @relation(fields: [business_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "transactions_business_id_foreign")
  categories                            categories?         @relation(fields: [category_id], references: [id], onUpdate: NoAction, map: "transactions_category_id_foreign")
  users_transactions_user_idTousers     users               @relation("transactions_user_idTousers", fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "transactions_user_id_foreign")

  @@index([book_id, category_id], map: "idx_book_category")
  @@index([book_id, transaction_date, id], map: "idx_book_date_id")
  @@index([book_id, mode], map: "idx_book_mode")
  @@index([book_id, type], map: "idx_book_type")
  @@index([book_id, user_id], map: "idx_book_user")
  @@index([approved_by], map: "transactions_approved_by_foreign")
  @@index([business_id], map: "transactions_business_id_foreign")
  @@index([category_id], map: "transactions_category_id_foreign")
  @@index([user_id], map: "transactions_user_id_foreign")
}

model users {
  id                                           BigInt                   @id @default(autoincrement()) @db.UnsignedBigInt
  name                                         String
  email                                        String                   @unique(map: "users_email_unique")
  email_verified_at                            DateTime?                @db.Timestamp(0)
  password                                     String
  role                                         String                   @default("user")
  remember_token                               String?                  @db.VarChar(100)
  notification_preferences                     String?                  @db.LongText
  created_at                                   DateTime?                @db.Timestamp(0)
  updated_at                                   DateTime?                @db.Timestamp(0)
  activity_logs                                activity_logs[]
  book_user                                    book_user[]
  business_user                                business_user[]
  recurring_transactions                       recurring_transactions[]
  transactions_transactions_approved_byTousers transactions[]           @relation("transactions_approved_byTousers")
  transactions_transactions_user_idTousers     transactions[]           @relation("transactions_user_idTousers")
}

enum categories_type {
  income
  expense
}

enum recurring_transactions_type {
  income
  expense
}

enum transactions_type {
  income
  expense
}

enum recurring_transactions_frequency {
  daily
  weekly
  monthly
}

enum transactions_status {
  pending
  approved
  rejected
}
